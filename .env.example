# 비워두면 동일 오리진의 /api 경로를 사용합니다.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SNS 공급자 클라이언트 식별자입니다. 공급자 콘솔에 아래 콜백을 정확히 등록합니다.
# http://localhost:3000/oauth/google/callback
# http://localhost:3000/oauth/kakao/callback
# http://localhost:3000/oauth/naver/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_APPLE_AUTH_URL=

# Access Token은 로그인 응답에서 받고 Refresh Token은 HttpOnly Cookie로 관리합니다.
# 고정 Bearer/JWT 비밀키를 NEXT_PUBLIC_* 환경변수에 넣지 마세요.

# 공급자 콘솔에 등록한 URI와 스킴·호스트·포트·경로·슬래시까지 같아야 합니다.
# 비워두면 현재 origin의 /oauth/{provider}/callback을 사용합니다.
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/callback
NEXT_PUBLIC_NAVER_REDIRECT_URI=http://localhost:3000/oauth/naver/callback
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# Google Cloud Text-to-Speech 서버 전용 설정입니다. 브라우저에 노출되는
# NEXT_PUBLIC_* 변수로 넣지 마세요. Cloud TTS를 활성화하고 ADC를 구성합니다.
# 로컬: gcloud auth application-default login
# 서비스 계정: 아래 변수에 다운로드한 JSON 키 파일의 절대 경로를 지정합니다.
GOOGLE_APPLICATION_CREDENTIALS=
# 기본값은 한국어 Chirp 3 HD Aoede이며 다른 한국어 Chirp 화자로 바꿀 수 있습니다.
GOOGLE_CLOUD_TTS_VOICE=ko-KR-Chirp3-HD-Aoede
