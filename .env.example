# 비워두면 동일 오리진의 /api 경로를 사용합니다.
NEXT_PUBLIC_API_BASE_URL=

# 개발 서버에서만 사용하는 로컬 임시 계정 허용 여부입니다.
# API 주소가 비어 있으면 개발 환경에서 자동 활성화됩니다.
NEXT_PUBLIC_ENABLE_DEV_ACCOUNT=true

# SNS 제공자별 OAuth 인가 페이지. 콜백은 /auth?provider=...&code=... 형식을 사용합니다.
NEXT_PUBLIC_GOOGLE_AUTH_URL=
NEXT_PUBLIC_KAKAO_AUTH_URL=
NEXT_PUBLIC_NAVER_AUTH_URL=
NEXT_PUBLIC_APPLE_AUTH_URL=
