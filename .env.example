# 운영 Backend origin입니다. /api 경로는 클라이언트가 붙입니다.
NEXT_PUBLIC_API_BASE_URL=https://api.voice-coaching.site

# 개발 서버에서만 사용하는 로컬 임시 계정 허용 여부입니다.
# API 주소가 비어 있으면 개발 환경에서 자동 활성화됩니다.
NEXT_PUBLIC_ENABLE_DEV_ACCOUNT=false

# 브라우저에 노출 가능한 OAuth 공개 식별자입니다. Client Secret은 넣지 않습니다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REST_API_KEY=
